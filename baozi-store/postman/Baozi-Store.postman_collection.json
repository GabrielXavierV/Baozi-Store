{
  "info": {
    "name": "Baozi Store API",
    "description": "Coleção de testes para a API REST da Baozi Store.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    }
  ],
  "item": [
    {
      "name": "Clientes",
      "item": [
        {
          "name": "Criar Cliente",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"João da Silva\",\n  \"clienteDesde\": \"2026-08-22\"\n}"
            },
            "url": {"raw": "{{baseUrl}}/clientes", "host": ["{{baseUrl}}"], "path": ["clientes"]}
          }
        },
        {
          "name": "Listar Clientes",
          "request": {
            "method": "GET",
            "url": {"raw": "{{baseUrl}}/clientes", "host": ["{{baseUrl}}"], "path": ["clientes"]}
          }
        },
        {
          "name": "Consultar Cliente por ID",
          "request": {
            "method": "GET",
            "url": {"raw": "{{baseUrl}}/clientes/1", "host": ["{{baseUrl}}"], "path": ["clientes", "1"]}
          }
        },
        {
          "name": "Excluir Cliente",
          "request": {
            "method": "DELETE",
            "url": {"raw": "{{baseUrl}}/clientes/1", "host": ["{{baseUrl}}"], "path": ["clientes", "1"]}
          }
        }
      ]
    },
    {
      "name": "Produtos",
      "item": [
        {
          "name": "Criar Produto",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Baozi Tradicional\",\n  \"preco\": 8.50,\n  \"estoque\": true\n}"
            },
            "url": {"raw": "{{baseUrl}}/produtos", "host": ["{{baseUrl}}"], "path": ["produtos"]}
          }
        },
        {
          "name": "Listar Produtos",
          "request": {
            "method": "GET",
            "url": {"raw": "{{baseUrl}}/produtos", "host": ["{{baseUrl}}"], "path": ["produtos"]}
          }
        },
        {
          "name": "Consultar Produto por ID",
          "request": {
            "method": "GET",
            "url": {"raw": "{{baseUrl}}/produtos/1", "host": ["{{baseUrl}}"], "path": ["produtos", "1"]}
          }
        },
        {
          "name": "Excluir Produto",
          "request": {
            "method": "DELETE",
            "url": {"raw": "{{baseUrl}}/produtos/1", "host": ["{{baseUrl}}"], "path": ["produtos", "1"]}
          }
        }
      ]
    },
    {
      "name": "Pedidos",
      "item": [
        {
          "name": "Criar Pedido",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clienteId\": 1,\n  \"produtoId\": 1,\n  \"quantidade\": 3\n}"
            },
            "url": {"raw": "{{baseUrl}}/pedidos", "host": ["{{baseUrl}}"], "path": ["pedidos"]}
          }
        },
        {
          "name": "Listar Pedidos",
          "request": {
            "method": "GET",
            "url": {"raw": "{{baseUrl}}/pedidos", "host": ["{{baseUrl}}"], "path": ["pedidos"]}
          }
        },
        {
          "name": "Consultar Pedido por ID",
          "request": {
            "method": "GET",
            "url": {"raw": "{{baseUrl}}/pedidos/1", "host": ["{{baseUrl}}"], "path": ["pedidos", "1"]}
          }
        },
        {
          "name": "Excluir Pedido",
          "request": {
            "method": "DELETE",
            "url": {"raw": "{{baseUrl}}/pedidos/1", "host": ["{{baseUrl}}"], "path": ["pedidos", "1"]}
          }
        }
      ]
    }
  ]
}
